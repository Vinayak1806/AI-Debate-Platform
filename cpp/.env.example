# .env.example
# Rename this file to .env and replace the values with your actual secrets.
# IMPORTANT: NEVER commit your actual .env file to version control (e.g., Git).

# Flask Secret Key for session management (generate a strong random string)
# You can generate one via python: `import secrets; print(secrets.token_hex(32))`
FLASK_SECRET_KEY=your_secure_random_flask_secret_key_here

# Google Gemini API Key
# Get one from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=debate_platform
DB_PORT=3306

# Optional: Flask Environment (development/production)
FLASK_ENV=development
FLASK_DEBUG=1
